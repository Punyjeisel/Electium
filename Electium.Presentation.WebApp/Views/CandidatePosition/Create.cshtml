@model Electium.Presentation.WebApp.ViewModels.CandidatePosition.CreateCandidatePositionViewModel

@{
    ViewData["Title"] = "Asignar Candidato";
}

<h2>Asignar Candidato a Puesto</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CandidateId" class="form-label"></label>
        <select asp-for="CandidateId" asp-items="Model.Candidates" class="form-select">
            <option value="">-- Seleccione un candidato --</option>
        </select>
        <span asp-validation-for="CandidateId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ElectivePositionId" class="form-label"></label>
        <select asp-for="ElectivePositionId" asp-items="Model.Positions" class="form-select">
            <option value="">-- Seleccione un puesto --</option>
        </select>
        <span asp-validation-for="ElectivePositionId" class="text-danger"></span>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Asignar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}