@model Electium.Presentation.WebApp.ViewModels.CandidatePosition.DeleteCandidatePositionViewModel

@{
    ViewData["Title"] = "Confirmar desvinculación";
}

<h2>@Model.Message</h2>
<p class="text-muted">
    <strong>@Model.CandidateFullName</strong> — @Model.PositionName
</p>

<form asp-action="Delete" method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-danger">Aceptar</button>
</form>