@model Electium.Presentation.WebApp.ViewModels.Candidate.EditCandidateViewModel

@{
    ViewData["Title"] = "Editar Candidato";
}

<h2>Editar Candidato</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentPhotoPath" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Foto actual</label><br />
        <img src="@Model.CurrentPhotoPath" alt="foto" style="height:80px;" />
    </div>

    <div class="mb-3">
        <label asp-for="Photo" class="form-label"></label>
        <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
        <span asp-validation-for="Photo" class="text-danger"></span>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}