@model Electium.Presentation.WebApp.ViewModels.Election.ElectionIndexViewModel
@using Electium.Core.Domain.Enums

@{
    ViewData["Title"] = "Elecciones";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Elecciones</h2>
    @if (!Model.HasActive)
    {
        <a asp-action="Create" class="btn btn-primary">Iniciar nuevo proceso electivo</a>
    }
    else
    {
        <span class="badge bg-warning text-dark">Hay una elección activa</span>
    }
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Fecha</th>
            <th>Partidos</th>
            <th>Puestos</th>
            <th>Votos emitidos</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Elections)
        {
            var isActive = item.Status == ElectionStatus.InProcess;
            <tr class="@(isActive ? "table-warning" : "")">
                <td>@item.Name</td>
                <td>@item.Date.ToString("dd/MM/yyyy")</td>
                <td>@item.PartyCount</td>
                <td>@item.PositionCount</td>
                <td>@item.TotalVotes</td>
                <td>
                    @if (isActive)
                    {
                        <span class="badge bg-warning text-dark">En proceso</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Finalizada</span>
                    }
                </td>
                <td class="text-end">
                    @if (isActive)
                    {
                        <a asp-action="Finish" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">Finalizar</a>
                    }
                    else
                    {
                        <a asp-action="Results" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Ver resultados</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>