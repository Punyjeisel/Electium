@model Electium.Presentation.WebApp.ViewModels.Voting.PositionListViewModel

@{
    ViewData["Title"] = "Puestos disponibles";
}

<h2>Puestos disponibles</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="list-group my-3">
    @foreach (var position in Model.Positions)
    {
        var done = Model.IsPositionCompleted(position.ElectivePositionId);
        <a asp-action="Candidates" asp-route-positionId="@position.ElectivePositionId"
           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <strong>@position.PositionName</strong><br />
                <small class="text-muted">
                    @position.CandidateCount candidatos · @position.PartyCount partidos
                </small>
            </div>
            @if (done)
            {
                <span class="badge bg-success">Votado</span>
            }
            else
            {
                <span class="badge bg-secondary">Pendiente</span>
            }
        </a>
    }
</div>

<form asp-action="Complete" method="post" class="mt-3">
    <button type="submit" class="btn btn-primary">Finalizar votación</button>
</form>