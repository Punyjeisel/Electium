@model Electium.Presentation.WebApp.ViewModels.PartyLeader.CreatePartyLeaderViewModel

@{
    ViewData["Title"] = "Agregar Relación";
}

<h2>Agregar Relación Dirigente ↔ Partido</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="UserId" class="form-label"></label>
        <select asp-for="UserId" asp-items="Model.Leaders" class="form-select">
            <option value="">-- Seleccione un dirigente --</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PoliticalPartyId" class="form-label"></label>
        <select asp-for="PoliticalPartyId" asp-items="Model.Parties" class="form-select">
            <option value="">-- Seleccione un partido --</option>
        </select>
        <span asp-validation-for="PoliticalPartyId" class="text-danger"></span>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}