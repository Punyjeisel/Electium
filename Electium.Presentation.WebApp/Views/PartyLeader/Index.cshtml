@model Electium.Presentation.WebApp.ViewModels.PartyLeader.PartyLeaderIndexViewModel

@{
    ViewData["Title"] = "Asignación de Dirigentes";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Asignación de Dirigentes</h2>
    @if (Model.CanModify)
    {
        <a asp-action="Create" class="btn btn-primary">Agregar relación</a>
    }
    else
    {
        <span class="badge bg-warning text-dark">Elección activa - solo lectura</span>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Dirigente</th>
            <th>Partido</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Relations)
        {
            <tr>
                <td>@item.UserFullName</td>
                <td>@item.PoliticalPartyAcronym</td>
                <td class="text-end">
                    @if (Model.CanModify)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">Desvincular</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>