@model Electium.Presentation.WebApp.ViewModels.Alliance.CreateAllianceRequestViewModel

@{
    ViewData["Title"] = "Nueva Solicitud de Alianza";
}

<h2>Nueva Solicitud de Alianza</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ReceiverPartyId" class="form-label"></label>
        <select asp-for="ReceiverPartyId" asp-items="Model.Parties" class="form-select">
            <option value="">-- Seleccione un partido --</option>
        </select>
        <span asp-validation-for="ReceiverPartyId" class="text-danger"></span>
    </div>

    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
    <button type="submit" class="btn btn-primary">Enviar solicitud</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}