@model Electium.Presentation.WebApp.ViewModels.Alliance.ConfirmAllianceViewModel

@{
    ViewData["Title"] = "Confirmar acción";
}

<h2>@Model.Message</h2>

<form asp-action="@Model.Action" method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn @Model.ButtonClass">@Model.ButtonLabel</button>
</form>