@model Electium.Presentation.WebApp.ViewModels.Alliance.AllianceIndexViewModel
@using Electium.Core.Domain.Enums

@{
    ViewData["Title"] = "Alianzas Políticas";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h2 class="mb-4">Alianzas Políticas</h2>

<!-- 1. PENDING RECEIVED -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        Solicitudes pendientes de responder
    </div>
    <div class="card-body">
        @if (!Model.ReceivedPending.Any())
        {
            <p class="text-muted">No tiene solicitudes pendientes.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Partido</th>
                        <th>Siglas</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReceivedPending)
                    {
                        <tr>
                            <td>@item.RequesterPartyName</td>
                            <td>@item.RequesterPartyAcronym</td>
                            <td>@item.RequestDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Accept" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-success">Aceptar</a>
                                <a asp-action="Reject" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">Rechazar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- 2. SENT -->
<div class="card mb-4">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <span>Solicitudes enviadas</span>
        <a asp-action="Create" class="btn btn-sm btn-light">Nueva solicitud</a>
    </div>
    <div class="card-body">
        @if (!Model.Sent.Any())
        {
            <p class="text-muted">No ha enviado solicitudes.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Partido destino</th>
                        <th>Siglas</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Sent)
                    {
                        <tr>
                            <td>@item.ReceiverPartyName</td>
                            <td>@item.ReceiverPartyAcronym</td>
                            <td>@item.RequestDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case AllianceStatus.Pending:
                                        <span class="badge bg-warning text-dark">En espera</span>
                                        break;
                                    case AllianceStatus.Accepted:
                                        <span class="badge bg-success">Aceptada</span>
                                        break;
                                    case AllianceStatus.Rejected:
                                        <span class="badge bg-danger">Rechazada</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- 3. ACTIVE -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        Alianzas vigentes
    </div>
    <div class="card-body">
        @if (!Model.Active.Any())
        {
            <p class="text-muted">No tiene alianzas vigentes.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Partido aliado</th>
                        <th>Siglas</th>
                        <th>Fecha de aceptación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Active)
                    {
                        <tr>
                            <td>@item.AllyPartyName</td>
                            <td>@item.AllyPartyAcronym</td>
                            <td>@item.AcceptedDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>