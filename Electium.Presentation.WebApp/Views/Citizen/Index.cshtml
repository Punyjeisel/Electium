@model Electium.Presentation.WebApp.ViewModels.Citizen.CitizenIndexViewModel

@{
    ViewData["Title"] = "Ciudadanos";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ciudadanos</h2>
    @if (Model.CanModify)
    {
        <a asp-action="Create" class="btn btn-primary">Crear ciudadano</a>
    }
    else
    {
        <span class="badge bg-warning text-dark">Elección activa - solo lectura</span>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Correo</th>
            <th>Documento</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Citizens)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@item.IdentityNumber</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-end">
                    @if (Model.CanModify)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        <a asp-action="Toggle" asp-route-id="@item.Id"
                           class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(item.IsActive ? "Desactivar" : "Activar")
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>