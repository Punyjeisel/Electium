<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electium</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Electium</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Administrator"))
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminHome" asp-action="Index">Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ElectivePosition" asp-action="Index">Puestos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Citizen" asp-action="Index">Ciudadanos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PoliticalParty" asp-action="Index">Partidos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Index">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PartyLeader" asp-action="Index">Dirigentes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Election" asp-action="Index">Elecciones</a>
                            </li>
                        </ul>
                    }
                    else if (User.IsInRole("PoliticalLeader"))
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="LeaderHome" asp-action="Index">Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Candidate" asp-action="Index">Candidatos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CandidatePosition" asp-action="Index">Asignaciones</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Alliance" asp-action="Index">Alianzas</a>
                            </li>
                        </ul>
                    }
                }

                <div class="ms-auto d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white me-3">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Account" asp-action="Login">Acceder</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            // Toggle password visibility
            function togglePassword(inputId) {
                const input = document.getElementById(inputId);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>