<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electium</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Electium</a>
            <div class="ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-white me-3">@User.Identity.Name</span>
                    <a class="btn btn-outline-light btn-sm"
                       asp-controller="Account" asp-action="Logout">Salir</a>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm"
                       asp-controller="Account" asp-action="Login">Acceder</a>
                }
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>